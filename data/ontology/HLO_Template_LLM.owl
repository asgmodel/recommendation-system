<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#"
         xml:base="http://example.org/hlo.owl"
         xmlns="http://example.org/hlo.owl#">

<owl:Ontology rdf:about="http://example.org/hlo.owl">
  <rdfs:label>Health Learning Ontology (HLO) - Professional Arranged Version</rdfs:label>
  <rdfs:comment>Core template classes are preserved unchanged. Additional concept packages are arranged professionally using short class symbols while full labels and source metadata are retained.</rdfs:comment>
</owl:Ontology>

<!-- Object Properties -->
<owl:ObjectProperty rdf:about="#relatedConcept">
  <rdfs:domain rdf:resource="#LearningResource"/>
  <rdfs:range rdf:resource="#MedicalConcept"/>
</owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#recommendedFor">
  <rdfs:domain rdf:resource="#LearningResource"/>
  <rdfs:range rdf:resource="#ResidentLevel"/>
</owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#hasContext">
  <rdfs:domain rdf:resource="#Learner"/>
  <rdfs:range rdf:resource="#Context"/>
</owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#hasLevel">
  <rdfs:domain rdf:resource="#Learner"/>
  <rdfs:range rdf:resource="#ResidentLevel"/>
</owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#equivalentConcept">
  <rdfs:domain rdf:resource="#MedicalConcept"/>
  <rdfs:range rdf:resource="#MedicalConcept"/>
</owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#teachesConcept">
  <rdfs:domain rdf:resource="#LearningResource"/>
  <rdfs:range rdf:resource="#MedicalConcept"/>
</owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#supportsObjective">
  <rdfs:domain rdf:resource="#LearningResource"/>
  <rdfs:range rdf:resource="#LearningObjective"/>
</owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#requiresCompetency">
  <rdfs:domain rdf:resource="#LearningObjective"/>
  <rdfs:range rdf:resource="#Competency"/>
</owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#developsSkill">
  <rdfs:domain rdf:resource="#Competency"/>
  <rdfs:range rdf:resource="#ClinicalSkill"/>
</owl:ObjectProperty>
<owl:ObjectProperty rdf:about="#hasCompetencyGap">
  <rdfs:domain rdf:resource="#Learner"/>
  <rdfs:range rdf:resource="#CompetencyGap"/>
</owl:ObjectProperty>

<!-- Data Properties -->
<owl:DatatypeProperty rdf:about="#conceptCode">
  <rdfs:domain rdf:resource="#MedicalConcept"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#conceptName">
  <rdfs:domain rdf:resource="#MedicalConcept"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#sourceOntology">
  <rdfs:domain rdf:resource="#MedicalConcept"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#sourceIdentifier">
  <rdfs:domain rdf:resource="#MedicalConcept"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#conceptCategory">
  <rdfs:domain rdf:resource="#MedicalConcept"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#resourceTitle">
  <rdfs:domain rdf:resource="#LearningResource"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#difficultyLevel">
  <rdfs:domain rdf:resource="#LearningResource"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#publicationYear">
  <rdfs:domain rdf:resource="#LearningResource"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#timestamp">
  <rdfs:domain rdf:resource="#TemporalContext"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#durationMinutes">
  <rdfs:domain rdf:resource="#TemporalContext"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#locationName">
  <rdfs:domain rdf:resource="#LocationContext"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#activityName">
  <rdfs:domain rdf:resource="#ActivityContext"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

